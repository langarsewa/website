---
/**
 * Change: page → kind → details. Phase 1 ships the structure; Words and Picture show a
 * "coming in the next update" sheet, and Something else drafts an email. Phase 2 wires the
 * same steps to PUT /api/content, POST /api/photos and POST /api/requests.
 */
import App from '../../layouts/App.astro';

const pages = [
  { name: 'Home', what: 'Headline figures, the four doors' },
  { name: 'Our Story', what: 'Journey, values, kitchen galleries' },
  { name: 'Our Work', what: 'Map of locations, programs' },
  { name: 'Impact', what: 'Numbers, milestones, crisis response, videos' },
  { name: 'Future Vision', what: 'Timeline, projects, the 2034 hospital' },
  { name: 'Join the Sewa', what: 'Bank details, steps, questions' },
  { name: 'Contact', what: 'Numbers, email, visit details' },
];
const hints = ['Add a section', 'Add a location pin', 'Change a button'];
const REQUEST_EMAIL = 'info@langarsewa.org';
---

<App title="Which page?" active="change" back="/" deskTitle="Make a change">
  <!-- Step 1: page -->
  <div data-step="page">
    <p class="lede">Every change starts with the page it belongs to. Tap one.</p>
    <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px">
      {pages.map((p) => (
        <button type="button" class="choice" data-pick-page={p.name}>
          <span class="choice__text">
            <b>{p.name}</b>
            <span>{p.what}</span>
          </span>
          <span class="choice__arrow" aria-hidden="true">
            →
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- Step 2: kind -->
  <div data-step="kind" hidden style="display: flex; flex-direction: column; gap: 12px">
    <p class="lede">
      What do you want to change on <span data-page-name>this page</span>?
    </p>
    <button type="button" class="door" data-pick-kind="words">
      <svg
        aria-hidden="true"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#102B4E"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 20h4l10-10-4-4L4 16v4zM13 7l4 4"></path>
      </svg>
      <span class="door__text">
        <b>Words or numbers</b>
        <span>A sentence, a figure, a date, a phone number. English and Punjabi together.</span>
      </span>
    </button>
    <button type="button" class="door" data-pick-kind="picture">
      <svg
        aria-hidden="true"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#102B4E"
        stroke-width="2"
        stroke-linecap="round"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="M3 16l5-5 4 4 3-3 6 6"></path>
        <circle cx="16" cy="9" r="1.5"></circle>
      </svg>
      <span class="door__text">
        <b>A picture</b>
        <span>Add a new photo, replace one, or fix a caption.</span>
      </span>
    </button>
    <button type="button" class="door" data-pick-kind="other">
      <svg
        aria-hidden="true"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#102B4E"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path>
      </svg>
      <span class="door__text">
        <b>Something else</b>
        <span>A new section, a new card, a new location pin. Describe it in your words.</span>
      </span>
    </button>
  </div>

  <!-- Step 3a: words (next update) -->
  <div data-step="words" hidden style="display: flex; flex-direction: column; gap: 12px">
    <section class="card card--warn">
      <span class="label">Coming in the next update</span>
      <h2 class="headline">Editing words from here</h2>
      <span class="sub">
        You will pick the sentence or figure on <span data-page-name>this page</span>, type the
        English and Punjabi, and save it to the test site in your name. Until then, send the new
        wording as a request and it is put on the test site for you.
      </span>
      <div class="btn-row">
        <button type="button" class="btn btn--primary" data-goto="other">
          Send it as a request
        </button>
        <button type="button" class="btn" data-goto="page">
          Another page
        </button>
      </div>
    </section>
    <p class="note">
      Both languages must be filled. Punjabi edits are flagged for a native-speaker look before
      publishing.
    </p>
  </div>

  <!-- Step 3b: picture (next update) -->
  <div data-step="picture" hidden style="display: flex; flex-direction: column; gap: 12px">
    <section class="card card--warn">
      <span class="label">Coming in the next update</span>
      <h2 class="headline">Adding pictures from here</h2>
      <span class="sub">
        You will choose a photo from your phone, say where on <span data-page-name>this page</span>
        it goes, and add a caption in both languages. It is resized automatically. Until then,
        describe the picture as a request and attach it to the email.
      </span>
      <div class="btn-row">
        <button type="button" class="btn btn--primary" data-goto="other">
          Send it as a request
        </button>
        <button type="button" class="btn" data-goto="page">
          Another page
        </button>
      </div>
    </section>
    <p class="note">Faces of children need the family's OK before upload.</p>
  </div>

  <!-- Step 3c: something else -->
  <form
    data-step="other"
    hidden
    id="request-form"
    style="display: flex; flex-direction: column; gap: 12px"
  >
    <p class="lede">
      Describe it in English or Punjabi. A draft is prepared on the test site; nothing goes live
      until someone publishes it.
    </p>
    <label class="field" for="change-text">
      What should change on <span data-page-name>this page</span>?
      <textarea
        id="change-text"
        name="text"
        rows="5"
        required
        placeholder='For example: add a program card for the winter blanket drive, titled "Winter Blanket Sewa", one paragraph, Punjabi too.'
      ></textarea>
    </label>
    <div class="chips" role="group" aria-label="Common requests">
      {hints.map((hint) => (
        <button type="button" class="chip" aria-pressed="false" data-hint={hint}>
          {hint}
        </button>
      ))}
    </div>
    <section class="card card--tight" style="font-size: 13px; color: var(--muted); gap: 4px">
      <b style="color: var(--navy)">What happens next</b>
      <span>1. Your mail app opens with the request written out; send it.</span>
      <span>
        2. A draft is built on the test site and you get a link with a plain-language summary.
      </span>
      <span>3. If it is right, Review and publish. If not, reply with what to fix.</span>
    </section>
    <p class="note">
      In this version the request goes by email to {REQUEST_EMAIL}. The next update sends it
      straight from here and shows its progress on Home.
    </p>
  </form>

  <!-- Step 4: done -->
  <div data-step="done" hidden style="display: flex; flex-direction: column; gap: 12px">
    <section class="card card--ok">
      <span class="label label--ok">Request drafted</span>
      <h2 class="headline" id="done-title">
        Your mail app has the request
      </h2>
      <span class="sub">
        Send it from there. A draft usually comes back within a day with a link to the test site and
        a summary of what was touched.
      </span>
      <a
        class="btn"
        id="done-mail"
        href={`mailto:${REQUEST_EMAIL}`}
        style="align-self: flex-start; margin-top: 4px"
      >
        Open the email again
      </a>
    </section>
    <section class="card card--tight" style="font-size: 13px; color: var(--muted); gap: 6px">
      <b style="color: var(--navy); font-size: 14px">Nothing is live yet</b>
      <span>
        Changes wait on the test site until someone taps Review and publish. You can keep adding
        changes first.
      </span>
    </section>
    <div class="btn-row">
      <button type="button" class="btn" data-goto="page">
        Another change
      </button>
      <a class="btn btn--accent" href="/review/" style="min-height: 44px; font-size: 14px">
        Review and publish
      </a>
    </div>
  </div>

  <div class="page-footer" slot="footer" id="save-bar" hidden>
    <button class="btn btn--primary" type="submit" form="request-form" id="send-request">
      Send the request
    </button>
  </div>
</App>

<script>
  import { boot, whoAmI } from '../../lib/shell';
  import { append, byId, show } from '../../lib/dom';
  import { firstName } from '../../lib/people';

  type Step = 'page' | 'kind' | 'words' | 'picture' | 'other' | 'done';
  const REQUEST_EMAIL = 'info@langarsewa.org';

  const state: { step: Step; page: string; kind: 'words' | 'picture' | 'other' | '' } = {
    step: 'page',
    page: '',
    kind: '',
  };
  let who = '';

  const headings: Record<Step, string> = {
    page: 'Which page?',
    kind: 'What kind of change?',
    words: 'Edit the words',
    picture: 'Add or replace a picture',
    other: 'Describe the change',
    done: 'Sent',
  };
  const backTo: Record<Step, Step | null> = {
    page: null,
    kind: 'page',
    words: 'kind',
    picture: 'kind',
    other: 'kind',
    done: 'page',
  };

  const header = document.querySelector<HTMLElement>('.topbar--sub');
  const titleEl = header?.querySelector<HTMLElement>('.topbar__title') ?? null;
  const backEl = header?.querySelector<HTMLAnchorElement>('.topbar__back') ?? null;
  let crumbEl: HTMLElement | null = null;
  if (titleEl) {
    crumbEl = document.createElement('span');
    crumbEl.className = 'kicker';
    const wrap = document.createElement('div');
    wrap.className = 'topbar__titles';
    titleEl.replaceWith(wrap);
    append(wrap, crumbEl, titleEl);
  }

  function crumb(): string {
    switch (state.step) {
      case 'page':
        return 'Make a change';
      case 'kind':
      case 'done':
        return state.page;
      case 'words':
        return `${state.page} · words`;
      case 'picture':
        return `${state.page} · picture`;
      case 'other':
        return `${state.page} · request`;
    }
  }

  function go(step: Step): void {
    state.step = step;
    for (const el of document.querySelectorAll<HTMLElement>('[data-step]')) {
      show(el, el.dataset.step === step);
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-page-name]')) {
      el.textContent = state.page || 'this page';
    }
    if (titleEl) titleEl.textContent = headings[step];
    if (crumbEl) crumbEl.textContent = crumb();
    document.title = `${headings[step]} · Sewa Control Room`;
    show(byId('save-bar'), step === 'other');
    if (backEl)
      backEl.setAttribute('aria-label', step === 'page' ? 'Back to home' : 'Back one step');
    const main = document.getElementById('main');
    main?.scrollIntoView({ block: 'start' });
    const focusTarget = document.querySelector<HTMLElement>(
      `[data-step="${step}"] button, [data-step="${step}"] textarea`,
    );
    if (step !== 'page') focusTarget?.focus({ preventScroll: true });
  }

  backEl?.addEventListener('click', (event) => {
    const target = backTo[state.step];
    if (target) {
      event.preventDefault();
      go(target);
    }
  });

  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-pick-page]')) {
    b.addEventListener('click', () => {
      state.page = b.dataset.pickPage ?? '';
      go('kind');
    });
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-pick-kind]')) {
    b.addEventListener('click', () => {
      const kind = b.dataset.pickKind as 'words' | 'picture' | 'other';
      state.kind = kind;
      go(kind);
    });
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-goto]')) {
    b.addEventListener('click', () => {
      const step = b.dataset.goto as Step;
      if (step === 'page') {
        state.page = '';
        state.kind = '';
      }
      if (step === 'other') state.kind = 'other';
      go(step);
    });
  }

  const textarea = byId<HTMLTextAreaElement>('change-text');
  for (const chip of document.querySelectorAll<HTMLButtonElement>('[data-hint]')) {
    chip.addEventListener('click', () => {
      const pressed = chip.getAttribute('aria-pressed') === 'true';
      chip.setAttribute('aria-pressed', pressed ? 'false' : 'true');
    });
  }

  function mailtoHref(): string {
    const chosen = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-hint][aria-pressed="true"]'),
    )
      .map((c) => c.dataset.hint ?? '')
      .filter(Boolean);
    const subject = `Change request: ${state.page}`;
    const lines = [
      `Page: ${state.page}`,
      chosen.length > 0 ? `Kind: ${chosen.join(', ')}` : null,
      '',
      textarea.value.trim(),
      '',
      `Sent from the Sewa Control Room${who ? ` by ${who}` : ''}.`,
    ].filter((l): l is string => l !== null);
    return `mailto:${REQUEST_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
  }

  byId<HTMLFormElement>('request-form').addEventListener('submit', (event) => {
    event.preventDefault();
    if (!textarea.value.trim()) {
      textarea.focus();
      textarea.reportValidity();
      return;
    }
    const href = mailtoHref();
    byId<HTMLAnchorElement>('done-mail').href = href;
    byId('done-title').textContent = `Your mail app has the ${state.page} request`;
    location.href = href;
    go('done');
  });

  go('page');
  void boot(async () => {
    const me = await whoAmI();
    if (me) who = firstName(me.email);
  });
</script>
