---
/** Full-screen photo viewer. Behaviour lives in src/scripts/lightbox.ts. */
import { getLocale, t } from '@/lib/i18n';
const locale = getLocale(Astro.currentLocale);
---

<div
  aria-label={t(locale, 'common.photoViewer')}
  aria-modal="true"
  class="lb"
  hidden
  id="lb"
  role="dialog"
>
  <button aria-label={t(locale, 'common.close')} class="lb-x" id="lb-x" type="button">
    <svg
      fill="none"
      height="22"
      stroke="#fff"
      stroke-linecap="round"
      stroke-width="2.4"
      viewBox="0 0 24 24"
      width="22"
    >
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
  <button
    aria-label={t(locale, 'common.previousPhoto')}
    class="lb-nav lb-prev"
    id="lb-prev"
    type="button"
  >
    <svg
      fill="none"
      height="24"
      stroke="#fff"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2.4"
      viewBox="0 0 24 24"
      width="24"
    >
      <path d="M15 5l-7 7 7 7"></path>
    </svg>
  </button>
  <figure class="lb-fig">
    <img alt="" id="lb-img" />
    <figcaption id="lb-cap"></figcaption>
  </figure>
  <button
    aria-label={t(locale, 'common.nextPhoto')}
    class="lb-nav lb-next"
    id="lb-next"
    type="button"
  >
    <svg
      fill="none"
      height="24"
      stroke="#fff"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2.4"
      viewBox="0 0 24 24"
      width="24"
    >
      <path d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
  <div class="lb-count" id="lb-count"></div>
</div>
