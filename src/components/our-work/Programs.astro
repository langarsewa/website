---
/** The eight "Beyond daily Langar" program cards. Content from src/content/programs.json. */
import Photo from '@/components/Photo.astro';
import Bi from '@/components/home/Bi.astro';
import { getLocale } from '@/lib/i18n';
import { image } from '@/lib/images';
import programs from '@/content/programs.json';

interface Program {
  title: { en: string; pa: string };
  text: { en: string; pa: string };
  image: string;
  alt: { en: string; pa: string };
  /** Optional trailing link after the text (the ambulance number), with the punctuation that follows it. */
  link?: { href: string; text: string; after: string };
}

const locale = getLocale(Astro.currentLocale);
const items = programs as Program[];
---

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 24px">
  {items.map((p) => (
    <div style="display: flex; flex-direction: column; gap: 14px">
      <div
        class="ph-img"
        style="height: 180px; border-radius: 14px; overflow: hidden; background: #E7E3D8"
      >
        <Photo
          src={image(p.image)}
          alt={p.alt[locale]}
          style="width: 100%; height: 100%; object-fit: cover; object-position: center; display: block"
        />
      </div>
      <h3 style="font-family: 'Newsreader', 'Noto Serif Gurmukhi', Georgia, serif; font-weight: 500; font-size: 22px; line-height: 1.2; margin: 0 0 8px; color: #102B4E">
        <Bi v={p.title} />
      </h3>
      <p style="margin: 0; color: #334155; font-size: 15px">
        <Bi v={p.text} />
        {p.link && (
          <Fragment>
            {' '}
            <a target="_blank" rel="noopener" href={p.link.href}>
              {p.link.text}
            </a>
            {p.link.after}
          </Fragment>
        )}
      </p>
    </div>
  ))}
</div>
