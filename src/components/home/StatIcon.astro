---
/** The 40px gold icon tile used in the "By the numbers" block. Markup copied from the reference. */
interface Props {
  name: string;
}
const { name } = Astro.props;

const paths: Record<string, string> = {
  bowl: '<path d="M4 11h16a8 8 0 0 1-16 0z"></path><path d="M9 7c-1-1.3 1-2.3 0-3.6M15 7c-1-1.3 1-2.3 0-3.6"></path>',
  clinic: '<rect height="16" rx="3" width="16" x="4" y="4"></rect><path d="M12 8v8M8 12h8"></path>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"></path><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5"></path>',
  hospital: '<path d="M3 21h18M5 21V7l7-4 7 4v14"></path><path d="M12 9v6M9 12h6"></path>',
  pot: '<path d="M4 10h16v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"></path><path d="M2 10h20M9 6V4M15 6V4"></path>',
  ambulance:
    '<path d="M2 16V7h11v9M13 10h4l4 4v2h-8"></path><circle cx="7" cy="17.5" r="2"></circle><circle cx="17" cy="17.5" r="2"></circle><path d="M7.5 9.5v4M5.5 11.5h4"></path>',
  bag: '<path d="M6 8h12l1 12H5z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path>',
  eye: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle>',
  drop: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"></path>',
};
const inner = paths[name];
if (inner === undefined) throw new Error(`StatIcon: unknown icon "${name}"`);
---

<span class="is-ic" style="background:#F4C430">
  <svg
    aria-hidden="true"
    fill="none"
    height="20"
    stroke="#0A1E37"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
    width="20"
    set:html={inner}
  />
</span>
