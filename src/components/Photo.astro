---
/**
 * A photo from src/assets/images, rendered as AVIF with a WebP fallback and a responsive
 * srcset. The <picture> wrapper is `display: contents`, so the <img> keeps behaving as the
 * direct child of its container and the reference CSS (object-fit, height: 100%) still applies.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  style?: string;
  id?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Rendered widths; defaults to a small set capped at the source width. */
  widths?: number[];
  sizes?: string;
  /** Extra attributes copied onto the <img> (for example data-* hooks). */
  attrs?: Record<string, string>;
}

const {
  src,
  alt,
  class: className,
  style,
  id,
  loading = 'lazy',
  fetchpriority,
  sizes = '(max-width: 700px) 100vw, (max-width: 1200px) 60vw, 720px',
  attrs = {},
} = Astro.props;

const widths = (
  Astro.props.widths ?? [...new Set([480, 800, 1200, src.width].filter((w) => w <= src.width))]
).sort((a, b) => a - b);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
  style={style}
  id={id}
  pictureAttributes={{ style: 'display:contents' }}
  {...attrs}
/>
