---
import Logo from '@/components/Logo.astro';
import LangSwitch from '@/components/LangSwitch.astro';
import T from '@/components/T.astro';
import { getLocale, localePath } from '@/lib/i18n';
import { pathFor, routes } from '@/lib/routes';
import site from '@/content/site.json';

const locale = getLocale(Astro.currentLocale);
const explore = routes.filter((r) => r.slug !== '');
---

<footer style="background: #0A1E37; color: #DCE3EC">
  <div style="max-width: 1200px; margin: 0 auto; padding: 64px 24px 32px">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 36px">
      <div>
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px">
          <Logo size={40} />
          <div style="font-family: 'Newsreader', 'Noto Serif Gurmukhi', Georgia, serif; font-size: 21px; color: #FFFFFF; line-height: 1.2">
            <T k="common.orgName" />
          </div>
        </div>
        <p style="margin: 0; font-size: 15px">
          <T k="footer.tagline" />
        </p>
        <div style="margin-top: 18px">
          <LangSwitch class="langsw-f" />
        </div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px; font-size: 15px">
        <div style="font-weight: 700; color: #F4C430; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 4px">
          <T k="footer.explore" />
        </div>
        {explore.map((r) => (
          <a href={localePath(locale, pathFor(r.slug))} style="color: #FFFFFF">
            <T k={`nav.${r.key}.label`} />
          </a>
        ))}
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px; font-size: 15px">
        <div style="font-weight: 700; color: #F4C430; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 4px">
          <T k="footer.contact" />
        </div>
        <a target="_blank" rel="noopener" href={`mailto:${site.email}`} style="color: #FFFFFF">
          {site.email}
        </a>
        <a target="_blank" rel="noopener" href={`tel:${site.phone.tel}`} style="color: #FFFFFF">
          {site.phone.display}
        </a>
        <span>
          <T k="footer.ambulanceSewa" />
          <a
            target="_blank"
            rel="noopener"
            href={`tel:${site.ambulance.tel}`}
            style="color: #FFFFFF"
          >
            {site.ambulance.display}
          </a>
        </span>
        <span>
          <span class={locale === 'pa' ? 'l-pa' : 'l-en'}>{site.address[locale]}</span>
        </span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px; font-size: 15px">
        <div style="font-weight: 700; color: #F4C430; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 4px">
          <T k="footer.follow" />
        </div>
        <a href={site.social.youtube} rel="noopener" style="color: #FFFFFF" target="_blank">
          <T k="footer.youtube" />
        </a>
        <a href={site.social.instagram} rel="noopener" style="color: #FFFFFF" target="_blank">
          <T k="footer.instagram" />
        </a>
        <a href={site.social.facebook} rel="noopener" style="color: #FFFFFF" target="_blank">
          <T k="footer.facebook" />
        </a>
        <span>
          <T k="footer.whatsapp" />
        </span>
      </div>
    </div>
    <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid #23395A; font-size: 13px; color: #B9C4D2">
      <T k="footer.copyright" />
    </div>
  </div>
</footer>
