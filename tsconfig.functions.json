{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@functions/*": ["functions/*"] },
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["functions/**/*", "tests/**/*", "config/*.json"]
}
