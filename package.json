{
  "name": "langarsewa.org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production website for Dhan Guru Ramdas Langar Sewa",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:content": "node --test tests/content/i18n-parity.test.mjs && node tests/content/parity.mjs",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:links": "node --test tests/content/links.test.mjs",
    "test": "pnpm test:content && pnpm test:links && pnpm test:redirects && pnpm test:e2e && pnpm test:a11y && pnpm test:visual",
    "lhci": "lhci autorun",
    "test:redirects": "node --test tests/content/redirects-wrangler.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource-variable/noto-serif-gurmukhi": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "^7.4.11",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@emnapi/runtime": "^1.11.3",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "node-html-parser": "^9.0.7",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.161.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "workerd",
      "@parcel/watcher"
    ]
  }
}
